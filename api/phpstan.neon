includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan.parallel.neon

parameters:
    level: 8
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
