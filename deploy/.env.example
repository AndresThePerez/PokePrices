# PokéPrices production environment template. On the server: install -m 600 .env.example .env, then edit.
# Placeholders only: the real values live in the server's git-ignored .env, never in this repository.

# Image tag loaded on the server (pokeprices-api:<tag> and pokeprices-web:<tag>).
IMAGE_TAG=1

# Published port of the web container. Bind 127.0.0.1 because the tunnel runs on the host itself.
APP_BIND=127.0.0.1
# pick a free port >= 8087; the real value lives only in the server .env
APP_PORT=8099

# the existing external Docker network the catalog service is attached to; created once on the server
SHARED_NET=example-net

# Absolute host directories, mounted read-only into the containers.
SNAPSHOTS_HOST_DIR=/srv/example/snapshots
DATASET_HOST_DIR=/srv/example/dataset

# Secrets: replace each change-me. Never commit a real value.
# generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=change-me
# generate with: openssl rand -hex 24
DB_PASSWORD=change-me
# generate with: openssl rand -hex 16 (the sign-up invite code; unset or wrong means nobody can register)
INVITE_CODE=change-me

# Idle session lifetime in minutes.
SESSION_LIFETIME=120
LOG_LEVEL=info
# log writes mail to the container log; set a real mailer only once a provider exists.
MAIL_MAILER=log

# Demo account password: leave empty so the demo is reachable only through its button.
DEMO_PASSWORD=
# PokéSearch API key: leave empty when the catalog needs none.
POKESEARCH_API_KEY=
# Discord webhook address of the hourly price-job report: leave empty and the report posts nothing.
PRICE_JOB_DISCORD_WEBHOOK_URL=

# TRUSTED_PROXIES is fixed to REMOTE_ADDR in deploy/stack.server.yml (not set here): it trusts only the
# immediate peer, nginx. A value of * would make a client-sent X-Forwarded-For header the client IP
# (never in production).
