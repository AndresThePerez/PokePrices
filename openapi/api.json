{
    "openapi": "3.1.0",
    "info": {
        "title": "Pok\u00e9Prices",
        "version": "0.1.0",
        "description": "Pok\u00e9Prices API: daily-close Pok\u00e9mon card prices.",
        "contact": {
            "name": "Pok\u00e9Prices"
        }
    },
    "servers": [
        {
            "url": "/v1"
        }
    ],
    "tags": [
        {
            "name": "Readiness",
            "description": "Whether the Pok\u00e9Prices API can serve requests."
        },
        {
            "name": "Cards",
            "description": "Pok\u00e9mon cards from the Pok\u00e9Search catalog."
        }
    ],
    "paths": {
        "/cards": {
            "get": {
                "operationId": "searchCards",
                "description": "Proxies Pok\u00e9Search's search with q (the search text), page (from 1; Pok\u00e9Search clamps it to its last reachable page) and page_size (Pok\u00e9Search's default is 24) only; any other query parameter answers 422. Pagination passes through unchanged: pages is Pok\u00e9Search's count, which stops at its 9,600-result window, so read pages rather than computing it from total.",
                "summary": "Search cards in the Pok\u00e9Search catalog",
                "tags": [
                    "Cards"
                ],
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `CardSummaryResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CardSummaryResource"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "total": {
                                                    "type": "integer"
                                                },
                                                "page": {
                                                    "type": "integer"
                                                },
                                                "pages": {
                                                    "type": "integer"
                                                },
                                                "page_size": {
                                                    "type": "integer"
                                                },
                                                "degraded": {
                                                    "type": "boolean"
                                                },
                                                "cached": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "total",
                                                "page",
                                                "pages",
                                                "page_size",
                                                "degraded",
                                                "cached"
                                            ],
                                            "additionalProperties": false
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        }
                    },
                    "304": {
                        "description": "Not Modified: the If-None-Match validator matches the current representation.",
                        "headers": {
                            "ETag": {
                                "description": "The validator of the current representation.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too Many Requests: the rate limit of this route is spent.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Seconds until the limit resets.",
                                "required": true,
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Pok\u00e9Search answered outside its contract (problem type https://pokeprices.andrestheperez.com/problems/upstream-contract).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Pok\u00e9Search did not answer (problem type https://pokeprices.andrestheperez.com/problems/upstream-unavailable).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Seconds before Pok\u00e9Search is worth asking again.",
                                "required": true,
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/cards/{id}": {
            "get": {
                "operationId": "getCard",
                "description": "The card comes from the Pok\u00e9Search catalog; variants lists the Pok\u00e9Prices variants of the card with their current TCGplayer mappings, and catalog names the Pok\u00e9Search dataset that answered. There is no price yet. An id outside the Pok\u00e9Search card id pattern, or one Pok\u00e9Search does not have, answers 404 card-not-found; catalog_missing is true when Pok\u00e9Prices holds variant rows for an id Pok\u00e9Search no longer has (the rows are flagged, never deleted). While Pok\u00e9Search is unavailable the last good copy answers with meta.degraded true and meta.stale_since, or 503 when there is none.",
                "summary": "Read one card, hydrated with its Pok\u00e9Prices variants",
                "tags": [
                    "Cards"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`CardResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/CardResource"
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "degraded": {
                                                    "type": "boolean"
                                                },
                                                "stale_since": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "degraded"
                                            ],
                                            "additionalProperties": false
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        }
                    },
                    "304": {
                        "description": "Not Modified: the If-None-Match validator matches the current representation.",
                        "headers": {
                            "ETag": {
                                "description": "The validator of the current representation.",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "An error",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too Many Requests: the rate limit of this route is spent.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Seconds until the limit resets.",
                                "required": true,
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Pok\u00e9Search answered outside its contract (problem type https://pokeprices.andrestheperez.com/problems/upstream-contract).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Pok\u00e9Search did not answer (problem type https://pokeprices.andrestheperez.com/problems/upstream-unavailable).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "description": "Seconds before Pok\u00e9Search is worth asking again.",
                                "required": true,
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/ready": {
            "get": {
                "operationId": "getReady",
                "description": "Probes Postgres, both Redis roles and Pok\u00e9Search and reports each check as ok or fail. Every check ok answers 200; any failed check answers 503 problem+json carrying the same checks map.",
                "summary": "Readiness of the Pok\u00e9Prices API and the services it needs",
                "tags": [
                    "Readiness"
                ],
                "responses": {
                    "200": {
                        "description": "Every dependency answered.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "checks": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "string",
                                                "enum": [
                                                    "ok",
                                                    "fail"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "checks"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "At least one dependency did not answer.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "string"
                                        },
                                        "title": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "integer"
                                        },
                                        "instance": {
                                            "type": "string"
                                        },
                                        "request_id": {
                                            "type": "string"
                                        },
                                        "detail": {
                                            "type": "string"
                                        },
                                        "checks": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "string",
                                                "enum": [
                                                    "ok",
                                                    "fail"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "type",
                                        "title",
                                        "status",
                                        "instance",
                                        "request_id",
                                        "detail",
                                        "checks"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CardResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "supertype": {
                        "type": "string"
                    },
                    "subtypes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "hp": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "types": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "rarity": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "number": {
                        "type": "string"
                    },
                    "artist": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "set": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "series": {
                                "type": "string"
                            },
                            "total": {
                                "type": "integer"
                            },
                            "release_date": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "series",
                            "total",
                            "release_date"
                        ],
                        "additionalProperties": false
                    },
                    "images": {
                        "type": "object",
                        "properties": {
                            "small": {
                                "type": "string"
                            },
                            "large": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "small",
                            "large"
                        ],
                        "additionalProperties": false
                    },
                    "variants": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "variant_key": {
                                    "type": "string"
                                },
                                "finish": {
                                    "type": "string"
                                },
                                "edition": {
                                    "type": "string"
                                },
                                "treatment": {
                                    "type": "string"
                                },
                                "sources": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "source": {
                                                "type": "string"
                                            },
                                            "product_id": {
                                                "type": "integer"
                                            },
                                            "subtype": {
                                                "type": "string"
                                            },
                                            "group_id": {
                                                "type": "integer"
                                            },
                                            "series_epoch": {
                                                "type": "integer"
                                            },
                                            "map_snapshot_day": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "source",
                                            "product_id",
                                            "subtype",
                                            "group_id",
                                            "series_epoch",
                                            "map_snapshot_day"
                                        ],
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "required": [
                                "variant_key",
                                "finish",
                                "edition",
                                "treatment",
                                "sources"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "catalog": {
                        "type": "object",
                        "properties": {
                            "seed_ref": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "seeded_at": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "catalog_missing",
                                    "ok",
                                    "unverified"
                                ]
                            }
                        },
                        "required": [
                            "seed_ref",
                            "seeded_at",
                            "status"
                        ],
                        "additionalProperties": false
                    }
                },
                "required": [
                    "id",
                    "name",
                    "supertype",
                    "subtypes",
                    "hp",
                    "types",
                    "rarity",
                    "number",
                    "artist",
                    "set",
                    "images",
                    "variants",
                    "catalog"
                ],
                "additionalProperties": false,
                "title": "CardResource"
            },
            "CardSummaryResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "number": {
                        "type": "string"
                    },
                    "rarity": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "supertype": {
                        "type": "string"
                    },
                    "set_id": {
                        "type": "string"
                    },
                    "set_name": {
                        "type": "string"
                    },
                    "release_date": {
                        "type": "string"
                    },
                    "image_small": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "number",
                    "rarity",
                    "supertype",
                    "set_id",
                    "set_name",
                    "release_date",
                    "image_small"
                ],
                "additionalProperties": false,
                "title": "CardSummaryResource"
            },
            "Problem": {
                "type": "object",
                "description": "RFC 9457 problem details; type is https://pokeprices.andrestheperez.com/problems/<slug>.",
                "properties": {
                    "type": {
                        "type": "string",
                        "format": "uri"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "instance": {
                        "type": "string"
                    },
                    "request_id": {
                        "type": "string"
                    },
                    "detail": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object",
                        "description": "Validation messages per input field (422 only).",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "catalog_missing": {
                        "type": "boolean",
                        "description": "card-not-found only: true when Pok\u00e9Search no longer has the card but Pok\u00e9Prices still holds variant rows for it."
                    }
                },
                "required": [
                    "type",
                    "title",
                    "status",
                    "instance",
                    "request_id"
                ],
                "additionalProperties": false,
                "title": "Problem"
            }
        }
    }
}