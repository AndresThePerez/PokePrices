{
  "default_kind": "hash",
  "kinds": {
    "api/phpstan.neon": "phpstan-params",
    "api/phpunit.xml": "phpunit-xml",
    "web/tsconfig.json": "tsconfig",
    "web/tsconfig.app.json": "tsconfig",
    "web/tsconfig.node.json": "tsconfig",
    "web/vitest.config.ts": "vitest",
    "web/.prettierignore": "ignore-lines",
    "api/composer.json#.scripts": "json-subtree:.scripts",
    "api/composer.json#.config": "json-subtree:.config",
    "web/package.json#.scripts": "json-subtree:.scripts",
    "web/package.json#.engines": "json-subtree:.engines",
    "web/package.json#.overrides": "json-subtree:.overrides"
  },
  "discovery": [
    "**/phpstan*.neon*",
    "**/.phpstan*",
    "**/phpunit*.xml*",
    "**/pint.json",
    "**/.pint.json",
    "**/rector.php",
    "**/eslint.config.*",
    "**/.eslintrc*",
    "**/.eslintignore",
    "**/tsconfig*.json",
    "**/vitest.config.*",
    "**/vitest.workspace.*",
    "**/.prettierrc*",
    "**/prettier.config.*",
    "**/.prettierignore",
    "**/.spectral.*",
    "**/.gitleaks*",
    "**/.trivyignore*",
    "**/Dockerfile*",
    "**/compose*.yml",
    "**/docker-compose*.yml",
    "docker/**/*.conf",
    ".github/workflows/*",
    "**/.agent-precommit-allow"
  ],
  "alternates": [
    "api/phpstan.neon.dist",
    "api/.phpstan.neon",
    "api/.phpstan.neon.dist",
    "api/phpstan.dist.neon",
    "api/.phpstan.dist.neon",
    "api/phpunit.xml.dist",
    "api/phpunit.dist.xml",
    "api/.pint.json",
    "web/.eslintrc",
    "web/.eslintrc.js",
    "web/.eslintrc.cjs",
    "web/.eslintrc.json",
    "web/.eslintignore",
    "web/prettier.config.js",
    "web/prettier.config.mjs",
    "web/.prettierrc.yaml",
    "web/.prettierrc.yml",
    "web/vitest.config.js",
    "web/vitest.config.mts",
    "web/vitest.config.mjs",
    "web/vitest.workspace.ts",
    ".spectral.yml",
    ".spectral.json",
    "trivy.yaml",
    "web/.npmrc"
  ]
}
